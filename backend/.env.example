# Copy to .env and adjust for local development (never commit .env).

JWT_SECRET_KEY=change-me-in-production
FIRST_ADMIN_EMAIL=you@example.com

# PostgreSQL connection URL (required).
# Local (Docker): postgres://postgres:postgres@127.0.0.1:5432/academy_rust
# Render: use the Internal or External URL from your managed Postgres instance.
ACADEMY_RUST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/academy_rust

ACADEMY_RUST_ADDR=127.0.0.1:8000
CMS_ENABLED=true

# Comma-separated browser origins allowed to call this API (CORS).
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if unset.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For `cargo test` only — database must exist (e.g. academy_test) and user must have DDL rights.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/academy_test
