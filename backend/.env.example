# Copy to .env and adjust for local development (never commit .env).

JWT_SECRET_KEY=change-me-in-production
FIRST_ADMIN_EMAIL=you@example.com

# PostgreSQL connection URL (required). This API does not use SQLite.
#
# Local Docker (repo root: `docker compose up -d postgres`): Postgres is on HOST port 5433
# (container still listens on 5432 inside the network). Keeps 5432 free for another Postgres.
#   postgres://postgres:postgres@127.0.0.1:5433/academy_rust
#
# Neon / managed: paste the console connection string; append ?sslmode=require if needed.
ACADEMY_RUST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/academy_rust

ACADEMY_RUST_ADDR=127.0.0.1:8000
CMS_ENABLED=true

# Comma-separated browser origins allowed to call this API (CORS). No trailing slash.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if unset (Render/production: set your frontend URL, e.g. https://your-app.vercel.app).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For `cargo test` only — database must exist (e.g. academy_test) and user must have DDL rights.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/academy_test
