# Copy to .env and adjust for local development (never commit .env).

JWT_SECRET_KEY=change-me-in-production
FIRST_ADMIN_EMAIL=you@example.com

# Optional
ACADEMY_RUST_DATABASE_URL=sqlite://academy_rust.db
ACADEMY_RUST_ADDR=127.0.0.1:8000
CMS_ENABLED=true

# Comma-separated browser origins allowed to call this API (CORS).
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if unset.
# Production: include your Vercel site origin(s), e.g. https://deadball-academy.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
